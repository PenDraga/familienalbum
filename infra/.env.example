# --- Datenbank ---
POSTGRES_USER=familienalbum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=familienalbum

# --- API ---
# Mindestens 32 Zeichen, zufällig: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info

# Erster globaler Admin (docker compose exec api npx prisma db seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Admin

# --- Push (optional) ---
# Service-Account-JSON nach infra/secrets/ legen und hier den Container-Pfad setzen
# FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
NOTIFY_DIGEST_SECONDS=90

# --- Pfade auf dem Host ---
MEDIA_PATH=/data/media
POSTGRES_PATH=/data/postgres
WEB_BUILD_PATH=../apps/app/build/web

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
