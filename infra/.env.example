# --- Datenbank ---
POSTGRES_USER=familienalbum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=familienalbum

# --- API ---
# Mindestens 32 Zeichen, zufällig: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info

# Erster globaler Admin (docker compose exec api node dist/seed.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Admin

# Betreiber-Angaben für die Datenschutzseite (/datenschutz.html) und GET /api/v1/meta (optional)
OPERATOR_NAME=
OPERATOR_EMAIL=

# --- Push (optional) ---
# Service-Account-JSON in den Secrets-Ordner legen (SECRETS_PATH, Standard ./secrets neben dieser Datei)
# und hier den Pfad aus Sicht des Containers setzen
# FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
NOTIFY_DIGEST_SECONDS=90

# --- Pfade auf dem Host (Bind-Mounts) ---
MEDIA_PATH=/data/media
POSTGRES_PATH=/data/postgres
REDIS_PATH=/data/redis
# Ordner mit dem Firebase-Dienstkonto (wird als /run/secrets eingehängt). Bei Stack-Managern wie Dockhand
# liegt die Compose-Datei woanders – dann absolut setzen, z.B. /mnt/user/appdata/familienalbum/secrets
# SECRETS_PATH=./secrets

# --- Images ---
# Tag der Images aus ghcr.io/pendraga (latest oder sha-<commit> aus dem Actions-Lauf)
IMAGE_TAG=latest

# --- Netz ---
# Port von Caddy auf dem Host (LAN-Zugriff ohne Tunnel: http://<host>:HTTP_PORT). 80 ist auf Unraid/Synology meist belegt.
HTTP_PORT=8090
WORKER_CONCURRENCY=2

# --- Cloudflare Tunnel (optional, Start mit: docker compose --profile tunnel up -d) ---
CLOUDFLARE_TUNNEL_TOKEN=
