# App-Store-Connect-API-Schlüssel für tool/testflight_upload.mjs (Kopie als ios/asc.env, nicht im Git).
# Anlegen: App Store Connect → Benutzer und Zugriff → Integrationen → App Store Connect API → Team-Schlüssel → «+»,
# Rolle «App-Manager». Die .p8-Datei gibt es nur einmal zum Download.
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Standard: ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
#ASC_KEY_PATH=/Users/du/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8
ASC_GROUP=Familie
