# App-Store-Connect-API-Schlüssel für tool/testflight_upload.mjs (Kopie als ios/asc.env, nicht im Git).
# Anlegen: App Store Connect → Benutzer und Zugriff → Integrationen → App Store Connect API → Team-Schlüssel → «+»,
# Rolle «App-Manager». Die .p8-Datei gibt es nur einmal zum Download.
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Standard: ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
#ASC_KEY_PATH=/Users/du/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8
ASC_GROUP=Familie
# Angaben für den Store-Eintrag (tool/asc_listing.mjs) – persönliche Werte bleiben lokal
ASC_SERVER_URL=https://album.example.ch
ASC_CONTACT_FIRST=Vorname
ASC_CONTACT_LAST=Nachname
ASC_CONTACT_EMAIL=du@example.ch
ASC_COPYRIGHT=2026 Vorname Nachname
# Demo-Konto für Apples Prüfer (Passwort nur in App Store Connect eintragen)
ASC_DEMO_ACCOUNT=review@example.ch
# Zweiter Schlüssel mit Rolle «Admin» (nur für den IPA-Export): damit holt xcodebuild das Verteilungs-Zertifikat selbst,
# ohne Apple-Konto in Xcode. Datei ebenfalls unter ~/.appstoreconnect/private_keys/AuthKey_<ID>.p8 ablegen.
ASC_SIGNING_KEY_ID=
