# Firebase-Werte für Push (Firebase-Konsole → Projekteinstellungen → Deine Apps).
# Kopie als firebase.env anlegen (ist in .gitignore). Die Werte landen im App-Binary, sind also nicht geheim –
# der Service-Account-Schlüssel für den Server gehört NICHT hierher, sondern nach infra/secrets/.
FIREBASE_PROJECT_ID=familienalbum-xxxxx
FIREBASE_SENDER_ID=123456789012
# iOS-App (Bundle-ID ch.familienalbum.familienalbum)
FIREBASE_IOS_API_KEY=AIza…
FIREBASE_IOS_APP_ID=1:123456789012:ios:abcdef0123456789
# Android-App (Paketname ch.familienalbum.familienalbum)
FIREBASE_ANDROID_API_KEY=AIza…
FIREBASE_ANDROID_APP_ID=1:123456789012:android:abcdef0123456789
