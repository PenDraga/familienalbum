NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://familienalbum:familienalbum@localhost:5432/familienalbum
REDIS_URL=redis://localhost:6379

# Mindestens 32 Zeichen, zufällig (z.B. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

MEDIA_ROOT=/data/media
# queue = BullMQ/Redis + separater Worker (Produktion) | inline = im API-Prozess (Entwicklung ohne Redis)
MEDIA_PROCESSING=queue
UPLOAD_CHUNK_SIZE=52428800
MAX_UPLOAD_BYTES=2000000000
SIGNED_URL_TTL_SECONDS=86400
# Optional, falls ffmpeg/ffprobe nicht im PATH sind
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Erster globaler Admin (wird von `prisma db seed` angelegt, falls nicht vorhanden)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Admin

# Optional: Tests gegen eine bestehende DB statt Testcontainers
# TEST_DATABASE_URL=postgresql://familienalbum:familienalbum@localhost:5432/familienalbum_test
