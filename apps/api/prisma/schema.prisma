// Familienalbum – Datenmodell (siehe CLAUDE.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  PHOTO
  VIDEO
}

enum RecapKind {
  MONTH
  YEAR
  SECONDS
}

/// Rückblick-Video (Monat, Jahr, Sekunden-Film) – vom Worker aus Fotos und Video-Ausschnitten gebaut.
model Recap {
  id          String      @id @default(uuid())
  familyId    String
  kind        RecapKind
  periodStart DateTime
  periodEnd   DateTime
  title       String
  status      MediaStatus @default(PROCESSING)
  error       String?
  durationSec Float?
  mediaCount  Int         @default(0)
  musicTrack  String?
  createdAt   DateTime    @default(now())
  readyAt     DateTime?
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, kind, periodStart])
  @@index([familyId, createdAt])
}

/// Fotobuch als druckfertiges PDF (ADR-0004). `pages` ist die Wahrheit; PDF und Seitenvorschauen werden daraus gerendert.
model PhotoBook {
  id          String       @id @default(uuid())
  familyId    String
  createdById String
  title       String
  format      BookFormat
  textMode    BookTextMode
  layout      BookLayout   @default(MIXED)
  months      String[] // JJJJ-MM, sortiert
  onlyCommented Boolean    @default(false)
  pages       Json
  pageCount   Int          @default(0)
  mediaCount  Int          @default(0)
  status      BookStatus   @default(DRAFT)
  error       String?
  pdfBytes    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  renderedAt  DateTime?
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("BookCreator", fields: [createdById], references: [id])

  @@index([familyId, createdAt])
}

enum BookFormat {
  SQUARE_21
  A4_LANDSCAPE
  SQUARE_30
}

enum BookTextMode {
  NONE
  CAPTIONS
  COMMENTS
}

/// Entwurf (prüfen und bearbeiten) → PDF wird erstellt → PDF fertig; jede Änderung macht wieder einen Entwurf
enum BookStatus {
  DRAFT
  RENDERING
  READY
  FAILED
}

/// Anordnung: ein Foto pro Seite, gemischt (1–4), Collage (bis 6)
enum BookLayout {
  SINGLE
  MIXED
  COLLAGE
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  displayName   String
  isAdmin       Boolean        @default(false) // globaler Admin
  isDisabled    Boolean        @default(false)
  avatarUpdatedAt DateTime?                    // gesetzt, wenn ein Profilbild unter _avatars/<id>.webp liegt
  deletedAt     DateTime?                      // Konto gelöscht: anonymisiert, Fotos/Kommentare bleiben («Gelöschtes Konto»)
  createdAt     DateTime       @default(now())
  memberships   FamilyMember[]
  refreshTokens RefreshToken[]
  devices       Device[]
  passwordResets PasswordResetToken[]
  uploads       Media[]        @relation("UploaderMedia")
  comments      Comment[]
  invites       Invite[]       @relation("InviteCreator")
  books         PhotoBook[]    @relation("BookCreator")
  uploadSessions UploadSession[]
}

model Family {
  id        String         @id @default(uuid())
  name      String
  createdAt DateTime       @default(now())
  members   FamilyMember[]
  media     Media[]
  invites   Invite[]
  recaps    Recap[]
  books     PhotoBook[]
  uploadSessions UploadSession[]
}

model FamilyMember {
  userId        String
  familyId      String
  isFamilyAdmin Boolean   @default(false)
  canUpload     Boolean   @default(false)
  canDownload   Boolean   @default(false)
  canComment    Boolean   @default(true)
  canCreateBooks Boolean  @default(false) // Fotobuch (PDF) anlegen, ADR-0004
  joinedAt      DateTime  @default(now())
  lastSeenAt    DateTime?
  activitySeenAt DateTime? // Aktivitäts-Verlauf zuletzt geöffnet (Ungelesen-Zähler)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([userId, familyId])
  @@index([familyId])
}

model Invite {
  id          String   @id @default(uuid())
  familyId    String
  code        String   @unique
  createdById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  maxUses     Int      @default(1)
  uses        Int      @default(0)
  // Flags, die das neue Mitglied bekommt
  canUpload   Boolean
  canDownload Boolean
  canComment  Boolean
  canCreateBooks Boolean @default(false)
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([familyId])
}

model Media {
  id           String      @id @default(uuid())
  familyId     String
  uploaderId   String
  type         MediaType
  status       MediaStatus
  sha256       String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Float?
  takenAt      DateTime // aus EXIF, Fallback Upload-Zeit
  uploadedAt   DateTime    @default(now())
  caption      String?
  processingError String?
  exif         Json? // Auszug: Kamera, Objektiv, Belichtung, GPS (siehe services/exif.ts)
  notifiedAt   DateTime? // Push "neue Medien" verschickt
  deletedAt    DateTime? // Soft-Delete
  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploader User      @relation("UploaderMedia", fields: [uploaderId], references: [id])
  comments Comment[]

  @@unique([familyId, sha256]) // Dedup pro Familie
  @@index([familyId, takenAt])
}

model Comment {
  id        String   @id @default(uuid())
  mediaId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime?            // gesetzt, wenn der Text nachträglich geändert wurde
  media  Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([mediaId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // SHA-256 des Klartext-Tokens
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Chunk-Uploads (M2)
model UploadSession {
  id             String   @id @default(uuid())
  familyId       String
  uploaderId     String
  sha256         String
  originalName   String
  mimeType       String
  sizeBytes      Int
  chunkSize      Int
  receivedChunks Int[]    @default([])
  takenAtHint    DateTime?
  caption        String? // Beschreibung aus dem Upload-Assistenten, wird beim Abschluss aufs Foto gesetzt
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([familyId, uploaderId])
  @@index([expiresAt])
}

// FCM-Token pro Gerät (M4)
model Device {
  id        String   @id @default(uuid())
  userId    String
  fcmToken  String   @unique
  platform  String // ios | android | windows | web
  locale    String? // Sprache des Geräts (de, en) für Push-Texte
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastError String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Passwort-Reset per E-Mail-Link: nur der SHA-256-Hash des Tokens liegt in der DB, einmalig nutzbar.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
